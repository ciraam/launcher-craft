{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Craft.ro",
  "version": "1.0.0",
  "identifier": "ro.craft.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Craft.ro",
        "width": 1240,
        "height": 790,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self' data:; connect-src 'self' https://api.github.com https://raw.githubusercontent.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "target/release/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
